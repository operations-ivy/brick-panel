#!/bin/sh
# Which panel brick1982 shows: the neon one (this repo) or LCARS (rpi_lcars).
#
#     deploy/panel-select neon
#     deploy/panel-select lcars
#     deploy/panel-select          # says which is on
#
# One at a time: both use tty1 and port 8767. Each panel's deploy timer runs
# only while that panel is in use, so a deploy never restarts the other one.
set -eu
case "${1:-}" in
neon)
    systemctl --user disable --now lcars-deploy.timer 2>/dev/null || true
    sudo systemctl disable --now lcars-kiosk.service 2>/dev/null || true
    sudo systemctl enable brick-panel.service brick-panel-kiosk.service
    sudo systemctl start brick-panel.service brick-panel-kiosk.service
    systemctl --user enable --now brick-panel-deploy.timer
    ;;
lcars)
    systemctl --user disable --now brick-panel-deploy.timer 2>/dev/null || true
    sudo systemctl disable --now brick-panel-kiosk.service brick-panel.service 2>/dev/null || true
    sudo systemctl enable lcars-kiosk.service
    sudo systemctl start lcars-kiosk.service
    systemctl --user enable --now lcars-deploy.timer
    ;;
"")
    ;;
*)
    echo "usage: $0 [neon|lcars]" >&2
    exit 2
    ;;
esac
if systemctl is-active --quiet brick-panel-kiosk.service; then
    echo "panel: neon"
elif systemctl is-active --quiet lcars-kiosk.service; then
    echo "panel: lcars"
else
    echo "panel: none running"
fi
